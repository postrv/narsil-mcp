# narsil-mcp SSE server for one config.yaml profile: the instance name is the
# profile, e.g. `systemctl --user enable --now narsil-mcp@dev`.
[Unit]
Description=narsil-mcp SSE server (profile %i)

[Service]
ExecStart=%h/.local/bin/narsil-mcp --profile %i --transport sse --http --gtags-generate --log-file %L/narsil-mcp/%i.log
LogsDirectory=narsil-mcp
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
